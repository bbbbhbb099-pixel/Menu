local function makeDraggable(frame, dragHandle)
	dragHandle = dragHandle or frame
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging and dragStart and startPos then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function spawnBubbles(parentFrame, count)
	if not parentFrame or not parentFrame.Parent then return end
	for _ = 1, (count or 10) do
		task.spawn(function()
			local size = math.random(14, 28)
			local bubble = Instance.new("Frame")
			bubble.Size = UDim2.fromOffset(size, size)
			bubble.Position = UDim2.new(math.random(10, 90) / 100, 0, math.random(20, 90) / 100, 0)
			bubble.AnchorPoint = Vector2.new(0.5, 0.5)
			bubble.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			bubble.BackgroundTransparency = 0.45
			bubble.BorderSizePixel = 0
			bubble.ZIndex = (parentFrame.ZIndex or 10) + 5
			bubble.Parent = parentFrame

			Instance.new("UICorner", bubble).CornerRadius = UDim.new(1, 0)
			local stroke = Instance.new("UIStroke", bubble)
			stroke.Color = Color3.fromRGB(255, 182, 212)
			stroke.Thickness = 1.5
			stroke.Transparency = 0.25

			local tw = TweenService:Create(bubble, TweenInfo.new(math.random(50, 80) / 100, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.fromOffset(size + 14, size + 14),
				Position = UDim2.new(bubble.Position.X.Scale + (math.random(-10, 10) / 100), 0, math.max(0.06, bubble.Position.Y.Scale - 0.22), 0),
				BackgroundTransparency = 1
			})
			tw:Play()
			tw.Completed:Connect(function()
				bubble:Destroy()
			end)
		end)
	end
end

